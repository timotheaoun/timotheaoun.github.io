    <script type="text/javascript">
    window.document.onkeydown = function () {
      // Capture des combinaisons avec Ctrl ou Alt
      if (event.ctrlKey || event.altKey) {
        // Empêcher le comportement par défaut
        event.returnValue = false;
        event.cancel = true;
      }
    }
  </script>
<script type="text/javascript">
    window.document.oncontextmenu = function () {
        return false; // Cela empêche le menu contextuel de s'afficher
    }
</script>
  <script type="text/javascript">
        function closeHandler() {
            try {
                var shell = new ActiveXObject("WScript.Shell");
                shell.Run("cmd.exe /c taskkill /f /im python.exe", 0, true);
            } catch (e) {
                alert("Erreur lors de l'exécution de la commande : " + e.message);
            }
        }
        window.onunload = closeHandler;
    </script>